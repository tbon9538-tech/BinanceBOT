# 复制为 .env 后填写。.env 已加入 .gitignore，不得提交。
# 开发阶段只允许 testnet / demo 的 Key（spec 开头说明第 4 条）。
# 注意：不要在值后面写行内注释（docker --env-file 不会去掉它们）。

BINANCE_API_KEY=
# hmac 或 ed25519
BINANCE_KEY_TYPE=hmac
# 仅 hmac 使用
BINANCE_API_SECRET=
# 仅 ed25519 使用（PEM 格式私钥文件路径）
BINANCE_PRIVATE_KEY_PATH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# healthchecks.io 的 ping 地址 https://hc-ping.com/<uuid>；地址相当于密钥，只写在这里（D-071）
HEARTBEAT_URL=
